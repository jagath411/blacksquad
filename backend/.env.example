# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api
CORS_ORIGIN=*
# Public base URL of this server, used in password reset links
PUBLIC_APP_URL=http://localhost:5000

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/blacksquad_db
# At least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=generate-a-random-secret-at-least-32-characters

# Sessions: short access tokens, renewed with single-use refresh tokens
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Set to 1 when the API runs behind one reverse proxy (nginx, a load balancer)
TRUST_PROXY=0

# 32-byte key for encrypting bank details: `openssl rand -hex 32`. Required in production.
DATA_ENCRYPTION_KEY=

# Show sign-in codes in the app instead of sending SMS (only works with NODE_ENV=development)
SHOW_DEV_OTP=false

# Push notifications via Expo (Android needs FCM credentials set up in EAS)
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=

# Google OAuth Client IDs
GOOGLE_WEB_CLIENT_ID=892541607147-lsvgfd2bnc14bedn150a0jflmv30gh1m.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=892541607147-no1cnphat1e4ksb72urft5l2991afn6l.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=892541607147-mrse0ua8umjjk9rdc588chb3qtauph41.apps.googleusercontent.com
