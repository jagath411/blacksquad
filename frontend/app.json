{
  "expo": {
    "name": "BlackSquad Mobility",
    "slug": "blacksquad-mobile",
    "version": "0.1.0",
    "scheme": "blacksquad",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BlackSquad uses your location to show where you are and to share your live position during a trip.",
          "locationAlwaysAndWhenInUsePermission": "While you are online as a driver, BlackSquad shares your location in the background so riders and your fleet owner can follow your trip.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#F3F5F7"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1D232B"
        }
      ]
    ],
    "android": {
      "package": "com.blacksquad.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F5F7"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.blacksquad.mobile",
      "infoPlist": {}
    },
    "extra": {
      "eas": {
        "projectId": "bd528c06-4bf1-4324-8864-6f734faa13f7"
      }
    },
    "owner": "jagath2001s-team"
  }
}
